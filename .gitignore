.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath
# Build outputs
/build/
/out/
/run/

# Gradle cache and wrapper properties (sometimes needed, but usually safe to ignore local overrides)
.gradle/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# IDE specific files
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log

# Minecraft assets/temp data if running locally
/assets/
/config/
/logs/
/resourcepacks/
/saves/
/screenshots/
/server-resource-packs/
/usercache.json
usernamecache.json
whitelist.json
ops.json
banned-ips.json
banned-players.json

# Secret configs (NEVER commit these!)
/quasar_auth_key.txt
/recovery.key
/master_password.hint
*.pem
*.key
.env
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
